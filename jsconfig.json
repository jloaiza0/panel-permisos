{
  // Revisión de tipos del JavaScript (npm run typecheck): TypeScript lee el
  // código y los comentarios JSDoc (@param, @returns) y avisa de errores
  // como pasar un texto donde va un número, sin tener que migrar a .ts.
  // Se revisa TODO src/ en modo estricto: la lógica y también las props de
  // cada componente y lo que se le pasa a las gráficas de Recharts. Las
  // pruebas quedan fuera (las revisa Vitest al correrlas).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "types": ["vite/client"],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules", "src/**/*.test.js", "src/**/*.test.jsx", "src/test"]
}
